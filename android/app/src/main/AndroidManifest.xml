<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter ne déclare INTERNET que dans les variantes debug et profile :
         sans cette ligne, l'APK release n'a aucun accès réseau et toutes les
         requêtes Appwrite échouent silencieusement. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Présence sécurisée : la caméra lit le QR de la séance et la position
         vérifie la proximité (service /attendance-secure). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+ exige une autorisation explicite pour afficher une
         notification. Sans cette ligne, les alertes de message urgent sont
         silencieusement ignorées sur les appareils récents. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Le motif de vibration propre au canal « Messages urgents ». -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Le libellé est celui qui s'affiche sous l'icône du lanceur : c'est la
         marque, avec ses majuscules, pas l'identifiant du dépôt.
         enableOnBackInvokedCallback active le retour prédictif d'Android 13+ ;
         aucun écran ne bloque le retour système (pas de PopScope), Flutter
         relaie donc le geste sans surprise. -->
    <application
        android:label="UniFlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Liens `uniflow:///<route>` : ceux des raccourcis du lanceur
                 (res/xml/shortcuts.xml), et demain ceux d'une notification.
                 L'embedding Flutter les transmet au routeur (deep linking
                 activé par défaut), qui les ramène à l'adresse interne. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="uniflow"/>
            </intent-filter>
            <!-- Raccourcis statiques : Emploi du temps, Messages, Notifications. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
